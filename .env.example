# Copy to `.env` (git-ignored) and adjust. NEVER commit real secrets.
# Every variable is optional; defaults live in backend/app/core/config.py.
# The containerized control plane (deploy/docker-compose.yml) reads this file
# too, but overrides the engine, Docker host, origins and hosts itself.

ENVCRAFTER_ENVIRONMENT=development

# LLM, only used for natural-language requests. Leave empty to disable prompt mode.
ENVCRAFTER_LLM_API_KEY=
ENVCRAFTER_LLM_MODEL=claude-opus-5-5

# Local dev server (uv run uvicorn ...): "simulated" runs the whole pipeline
# except the Docker calls. Real deployments run in the control plane.
ENVCRAFTER_ENGINE=simulated

# JSON arrays. Origins allowed to call the API / open WebSockets, and accepted Host headers.
ENVCRAFTER_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
ENVCRAFTER_ALLOWED_HOSTS=["localhost","127.0.0.1","*.localhost"]
