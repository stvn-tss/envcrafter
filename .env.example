# Copy to `.env` (git-ignored) and adjust. NEVER commit real secrets.
# Every variable is optional; defaults live in backend/app/core/config.py.
# The containerized control plane (deploy/docker-compose.yml) reads this file
# too, but overrides the engine, Docker host, origins and hosts itself.

# --- Core ---------------------------------------------------------------------

ENVCRAFTER_ENVIRONMENT=development

# Environments are served at http://<project>.<public_domain>.
# ENVCRAFTER_PUBLIC_DOMAIN=localhost

# Dev convenience: serve the static frontend from the API process (same origin).
# ENVCRAFTER_SERVE_FRONTEND=true
# ENVCRAFTER_FRONTEND_DIR=<repository root>/frontend

# Where templates, the image allow-list, generated workspaces and UI settings live.
# Change these only for a non-standard layout.
# ENVCRAFTER_TEMPLATES_DIR=<repository root>/templates
# ENVCRAFTER_IMAGE_ALLOWLIST=backend/app/policy/image_allowlist.yaml
# ENVCRAFTER_WORKSPACES_DIR=<repository root>/workspaces
# ENVCRAFTER_SETTINGS_FILE=<repository root>/data/settings.json

# Time zone written to each environment as ${EC_TZ} when the browser does not send one.
# ENVCRAFTER_TIMEZONE=Etc/UTC

# --- LLM (natural-language requests) -------------------------------------------

# Only used for natural-language requests and AI plans. Optional: the key can also be
# saved from the UI (Settings), which takes precedence over this one. Without any key,
# the UI still works with templates.
ENVCRAFTER_LLM_API_KEY=
ENVCRAFTER_LLM_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max (Opus 5.5 alone would use medium).
ENVCRAFTER_LLM_EFFORT=high
# ENVCRAFTER_LLM_TIMEOUT_SECONDS=180

# --- Engine ---------------------------------------------------------------------

# Local dev server (uv run uvicorn ...): "simulated" runs the whole pipeline
# except the Docker calls. Real deployments run in the control plane with
# "docker" (set for you by deploy/docker-compose.yml).
ENVCRAFTER_ENGINE=simulated

# Only used when ENVCRAFTER_ENGINE=docker.
# ENVCRAFTER_DOCKER_HOST=tcp://socket-proxy-api:2375
# ENVCRAFTER_DOCKER_BINARY=docker
# ENVCRAFTER_TRAEFIK_CONTAINER=envcrafter-traefik
# ENVCRAFTER_PULL_TIMEOUT_SECONDS=1800
# ENVCRAFTER_START_TIMEOUT_SECONDS=600
# ENVCRAFTER_STOP_TIMEOUT_SECONDS=20

# Delay between simulated engine actions (dev/tests only).
# ENVCRAFTER_SIMULATED_STEP_DELAY=0.4

# --- Origins / hosts --------------------------------------------------------------

# JSON arrays. Origins allowed to call the API / open WebSockets, and accepted Host headers.
ENVCRAFTER_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
ENVCRAFTER_ALLOWED_HOSTS=["localhost","127.0.0.1","*.localhost"]

# --- Tuning (defaults shown) ------------------------------------------------------

# Real-time channel sizing (services/event_bus.py).
# ENVCRAFTER_EVENT_HISTORY_SIZE=2000
# ENVCRAFTER_SUBSCRIBER_QUEUE_SIZE=500
# ENVCRAFTER_JOB_RETENTION_SECONDS=3600

# Reviewed AI plans wait this long for their deployment, at most this many at once.
# ENVCRAFTER_PLAN_TTL_SECONDS=900
# ENVCRAFTER_MAX_PLANS=32

# One `docker ps` serves every dashboard poll during this window.
# ENVCRAFTER_INVENTORY_CACHE_SECONDS=2

# Health watcher period while `up --wait` runs, and the step.progress throttle.
# ENVCRAFTER_HEALTH_POLL_SECONDS=5
# ENVCRAFTER_PROGRESS_INTERVAL_SECONDS=0.5

# Container logs: largest accepted `tail`, and concurrent `logs --follow` processes.
# ENVCRAFTER_LOG_TAIL_MAX=1000
# ENVCRAFTER_MAX_LOG_STREAMS=4
